# ZecClaim Environment Variables Configuration
# Copy this file to .env.local for local development

# MongoDB Connection String (Atlas free-tier compatible or local mongod)
MONGODB_URI=mongodb://localhost:27017/zecclaim

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Zcash Lightnode Configuration (Post-NU7 Default: Zcash India Mumbai Node)
NEXT_PUBLIC_ZCASH_LIGHTNODE_HOST=zebra.openlightnodes.org
NEXT_PUBLIC_ZCASH_LIGHTNODE_PORT=443

# Consensus Branch ID (NU7: 0x77190AD9)
NEXT_PUBLIC_ZCASH_CONSENSUS_BRANCH_ID=0x77190AD9

# Zcash Network: "mainnet" | "testnet"
NEXT_PUBLIC_ZCASH_NETWORK=testnet

# Default Campaign Slot Claim TTL (in seconds, default 7 days = 604800)
CLAIM_SLOT_TTL_SECONDS=604800

# Rate Limiting Secret / Salt for blind token hashing
TOKEN_HASH_PEPPER=dev-local-pepper-replace-in-production-must-be-32-bytes

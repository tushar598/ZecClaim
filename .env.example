# ZecClaim environment variables. Copy to .env.local for local development.
# Never commit real values.

# MongoDB connection string (Atlas or local). Unset = in-memory store (single process only, not for production).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/zecclaim

# High-entropy secret used to hash claim tokens and organizer secrets. REQUIRED in production.
# Generate one with: openssl rand -hex 32
# Changing it invalidates every existing claim link and organizer secret.
ADMIN_SECRET_PEPPER=

# Optional lightwalletd overrides (host:port). Defaults: testnet.zec.rocks:443 and zebra.openlightnodes.org:443.
# ZCASH_LIGHTWALLETD_TESTNET=testnet.zec.rocks:443
# ZCASH_LIGHTWALLETD_MAINNET=zebra.openlightnodes.org:443

# "off" disables on-chain lookups (tests / offline only: funding is then shown as "Not checked").
# ZECCLAIM_CHAIN_CHECKS=off

# Judge sandbox (one seeded, labeled fixture campaign). "off" removes it entirely.
# NEXT_PUBLIC_ZECCLAIM_SANDBOX=off

# "true" lets the app serve from memory when MONGODB_URI is set but unreachable. Default: fail with 503.
# ZECCLAIM_ALLOW_MEMORY_FALLBACK=false
